# =====================================================================
# Copy to .env and fill in real values.
# Do NOT commit .env.
# =====================================================================

# --- SQL Server source (used by sync/) ---
DB_SERVER=
DB_DATABASE=Inteligencia_Mercado
DB_UID=
DB_PWD=

# --- Supabase destination (used by sync/ and web/) ---
# REST API path — works behind corporate firewalls that block Postgres ports
SUPABASE_URL=https://<your-project>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- Optional: direct Postgres (only usable from networks without firewall) ---
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=6543
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=
